params {
  samplesheet                = null
  fasta                      = null
  gtf                        = null
  te_gtf                     = null
  star_index                 = null
  star_index_extra           = ''
  star_extra                 = '--outFilterMultimapNmax 100 --winAnchorMultimapNmax 100 --outFilterType BySJout --outFilterMultimapScoreRange 1 --sjdbScore 1'
  sjdb_overhang              = 'auto'
  strandedness_min_fraction  = 0.6
  tetranscripts_mode         = 'multi'
  tetranscripts_padj         = 0.05
  tetranscripts_foldchange   = 1
  tetranscripts_minread      = 1
  tetranscripts_extra        = ''
  outdir                     = 'results'
}

process {
  errorStrategy = 'retry'
  maxRetries    = 2

  withLabel: 'star_index' {
    cpus   = 8
    memory = '40 GB'
    time   = '3h'
  }
  withLabel: 'star_align' {
    cpus   = 12
    memory = '48 GB'
    time   = '4h'
    errorStrategy = { sleep(Math.pow(2, task.attempt) * 100); return 'retry' }
    maxRetries    = 3
  }
  withLabel: 'samtools' {
    cpus   = 8
    memory = '16 GB'
    time   = '2h'
  }
  withLabel: 'samtools_index' {
    cpus   = 4
    memory = '4 GB'
    time   = '30m'
  }
  withLabel: 'genepred' {
    cpus   = 1
    memory = '2 GB'
    time   = '30m'
  }
  withLabel: 'rseqc' {
    cpus   = 1
    memory = '4 GB'
    time   = '1h'
  }
  withLabel: 'strandedness' {
    cpus   = 1
    memory = '1 GB'
    time   = '10m'
  }
  withLabel: 'tecount' {
    cpus   = 4
    memory = '32 GB'
    time   = '4h'
  }
  withLabel: 'tetranscripts' {
    cpus   = 4
    memory = '32 GB'
    time   = '6h'
  }
  withLabel: 'multiqc' {
    cpus   = 1
    memory = '4 GB'
    time   = '30m'
  }
  withLabel: 'minimal' {
    cpus   = 1
    memory = '1 GB'
    time   = '10m'
  }
}

manifest {
  name        = 'rnaseq-star-tetranscripts'
  author      = 'Ali Altintas'
  homePage    = 'https://github.com/altintasali/rnaseq-star-tetranscripts'
  description = 'RNA-seq alignment with STAR and TE quantification with TEtranscripts'
  mainScript  = 'main.nf'
  nextflowVersion = '!>=23.04.0'
}

profiles {
  test {
    includeConfig 'conf/test.config'
  }
  slurm {
    includeConfig 'conf/slurm.config'
  }
}
